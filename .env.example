# Copy to .env.local. Never commit real keys.
# The guides and /api/ask render without these. The tracker needs the first two.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Used only by a server-side invite helper. The tracker works without it:
# create staff in the Supabase dashboard, then grant a role in the admin panel.
SUPABASE_SERVICE_ROLE_KEY=

# Existing Ask PermitGU guide. Without it, POST /api/ask returns 503 not_configured.
OPENROUTER_API_KEY=

# Optional shared rate limit for /api/ask. Limits stay per-instance until both are set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
